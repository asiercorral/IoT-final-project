# Copy this file to .env and adjust it. Never commit .env.
# Every line is optional: plantpulse/config.py holds the defaults shown here.

# PLANTPULSE_DEVICE_ID=XX

# MQTT broker (runs on the Pi)
# PLANTPULSE_MQTT_HOST=localhost
# PLANTPULSE_MQTT_PORT=1883

# Acquisition: seconds between readings, and where local files are written
# PLANTPULSE_READ_INTERVAL_S=300
# PLANTPULSE_DATA_DIR=data

# Grove wiring
# PLANTPULSE_ADC_I2C_ADDRESS=0x08
# PLANTPULSE_SOIL_ADC_CHANNEL=0
# PLANTPULSE_LIGHT_ADC_CHANNEL=2
# PLANTPULSE_DHT_TYPE=11
# PLANTPULSE_DHT_PIN=5
# PLANTPULSE_LED_BAR_PIN=16
