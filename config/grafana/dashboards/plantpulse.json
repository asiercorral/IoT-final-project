    {
      "type": "stat",
      "title": "Last reading",
      "description": "Time since the newest stored reading. Red after 15 min (three missed 5-minute cycles): the Pi, the acquisition or the MQTT subscriber stopped.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "plantpulse-sqlite"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
