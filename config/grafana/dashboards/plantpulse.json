  "panels": [
    {
      "type": "stat",
      "title": "Soil moisture now",
      "description": "Calibrated soil index: 0 % = dry substrate, 100 % = waterlogged substrate (T-12). Dashed lines: the basil profile's Check (45 %) and Attention (20 %) thresholds. Latest reading.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "plantpulse-sqlite"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "plantpulse-sqlite"
          },
          "queryType": "table",
          "queryText": "SELECT timestamp AS time, MAX(0.0, MIN(100.0, ROUND((soil_moisture_raw - $dry_mv) * 100.0 / ($wet_mv - $dry_mv), 1))) AS \"Soil moisture\" FROM readings\nWHERE device_id = '$device'\nORDER BY timestamp DESC LIMIT 1",
          "rawQueryText": "SELECT timestamp AS time, MAX(0.0, MIN(100.0, ROUND((soil_moisture_raw - $dry_mv) * 100.0 / ($wet_mv - $dry_mv), 1))) AS \"Soil moisture\" FROM readings\nWHERE device_id = '$device'\nORDER BY timestamp DESC LIMIT 1",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
