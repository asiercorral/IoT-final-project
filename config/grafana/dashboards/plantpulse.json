          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "plantpulse-sqlite"
          },
          "queryType": "table",
          "queryText": "SELECT CAST(strftime('%s', 'now') AS INTEGER) - MAX(timestamp) AS \"Last reading\"\nFROM readings WHERE device_id = '$device'",
          "rawQueryText": "SELECT CAST(strftime('%s', 'now') AS INTEGER) - MAX(timestamp) AS \"Last reading\"\nFROM readings WHERE device_id = '$device'",
